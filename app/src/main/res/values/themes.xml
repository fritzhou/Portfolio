<resources>
    <style name="Theme.AirNudge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#176B52</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="SectionTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BodyCopy" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="SettingLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>
    <style name="SettingSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
    </style>
    <style name="SettingSeekBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
    </style>
    <style name="OnboardingPage" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:lineSpacingExtra">8dp</item>
    </style>
</resources>
